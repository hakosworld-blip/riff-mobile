{
  "name": "Riff",
  "short_name": "Riff",
  "description": "A Material 3 music player for YouTube Music, YouTube, SoundCloud and your local library.",
  "start_url": "index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#131018",
